# ---------------------------------------------------------------------------
# Base de datos
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://motoerp:motoerp@localhost:5432/motoerp?schema=public"

# ---------------------------------------------------------------------------
# Seguridad
# Genera uno nuevo con:  openssl rand -base64 48
# ---------------------------------------------------------------------------
SESSION_SECRET="cambia-esto-por-una-cadena-larga-y-aleatoria-de-al-menos-32-caracteres"

# Horas de duracion de la sesion del usuario
SESSION_HORAS="12"

# ---------------------------------------------------------------------------
# Facturacion electronica
#
# PROVEEDOR_FE:
#   mock     -> genera el XML UBL 2.1 y simula la respuesta de SUNAT (por defecto)
#   nubefact -> envia el comprobante a la API de Nubefact (requiere URL y TOKEN)
# ---------------------------------------------------------------------------
PROVEEDOR_FE="mock"
NUBEFACT_URL=""
NUBEFACT_TOKEN=""

# Credenciales del usuario secundario SOL (solo si se integra directo con SUNAT)
SUNAT_USUARIO_SOL=""
SUNAT_CLAVE_SOL=""

# ---------------------------------------------------------------------------
# Respaldos
#
# El sistema hace un respaldo por dia automaticamente. Revisa cada hora si ya
# existe el del dia; si la computadora estuvo apagada, lo hace al encenderla.
#
# RESPALDOS_DIR   carpeta donde se guardan (por defecto: respaldos/)
# RESPALDOS_DIAS  dias que se conservan; nunca se borran los ultimos 10
# PG_DUMP_PATH    ruta a pg_dump si no esta en el PATH. Con el, el respaldo
#                 incluye la estructura de la base ademas de los datos
# RESPALDO_AUTOMATICO  ponlo en "off" para desactivar el respaldo diario
# ---------------------------------------------------------------------------
RESPALDOS_DIAS="30"
